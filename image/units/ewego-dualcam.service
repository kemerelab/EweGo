[Unit]
Description=EweGo dual camera recorder (Picamera2, CSI cameras)
Documentation=file:///opt/ewego/Firmware/dualcam/README.md
After=local-fs.target

[Service]
Type=simple
NotifyAccess=main
# Recordings go to /opt/ewego/recordings/<session>/
WorkingDirectory=/opt/ewego
Environment=PYTHONPATH=/opt/ewego/pylib
ExecStart=/usr/bin/python3 -u /opt/ewego/Firmware/dualcam/dual_cam_jp2.py
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
