[Unit]
Description=EweGo fuel gauge logger (MAX17048 on I2C1) and low-battery shutdown
Documentation=file:///opt/ewego/Firmware/fuel_gauge/README.md
After=local-fs.target
PartOf=ewego-record.target

[Service]
Type=simple
# Defaults, overridden by /etc/ewego/fuel.conf
Environment=OUT_DIR=/opt/ewego/recordings/fuel INTERVAL=2
Environment=SHUTDOWN=1 SHUTDOWN_SOC=8 SHUTDOWN_VOLTAGE=3.5 SHUTDOWN_SAMPLES=30
EnvironmentFile=-/etc/ewego/fuel.conf
Environment=PYTHONUNBUFFERED=1
# The logger is also the low-battery guard: it runs `systemctl poweroff`
# when SOC and voltage stay below the thresholds (see fuel.conf).
ExecStart=/usr/bin/python3 -u /opt/ewego/Firmware/fuel_gauge/log_fuel_gauge.py --out ${OUT_DIR} --interval ${INTERVAL} --shutdown ${SHUTDOWN} --shutdown-soc ${SHUTDOWN_SOC} --shutdown-voltage ${SHUTDOWN_VOLTAGE} --shutdown-samples ${SHUTDOWN_SAMPLES}
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
