[Unit]
Description=EweGo GPS logger (raw UBX + time sync CSV)
Documentation=file:///opt/ewego/Firmware/gps-test/README.md
After=local-fs.target
PartOf=ewego-record.target
# keep retrying (RestartSec apart) for as long as the target runs
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ewego
Environment=PYTHONPATH=/opt/ewego/pylib
Environment=PYTHONUNBUFFERED=1
# NTRIP_ARGS (e.g. --ntrip 192.168.1.213:2101/sheep) comes from /etc/ewego/gps.conf; empty = no RTK corrections
EnvironmentFile=-/etc/ewego/gps.conf
# Exit 1 = could not open the port / log file, 3 = 5 s of nothing but
# read/write errors; both restart. A dropped NTRIP stream does not exit
# (it reconnects every 30 s).
# Free-space guard: below 500 MB the start is skipped (exit 75; not a
# failure, no restart loop) and /run/ewego/space.json says why.
ExecCondition=/usr/local/bin/ewego-check-space /opt/ewego/gps-logs
ExecStart=/usr/bin/python3 -u /opt/ewego/Firmware/gps-test/gps_logger.py --port /dev/ttyAMA4 --baud 460800 --log-dir /opt/ewego/gps-logs $NTRIP_ARGS
OOMScoreAdjust=-500
# gps_logger.py stops cleanly on KeyboardInterrupt
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
