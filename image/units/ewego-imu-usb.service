[Unit]
Description=EweGo USB IMU logger (hub_imu, BNO055 over HID)
Documentation=file:///opt/ewego/Firmware/usbimu/README.md
After=local-fs.target
PartOf=ewego-record.target
# never stop restarting a recorder in the field
StartLimitIntervalSec=0

[Service]
# READY=1 once the module is open and the CSV exists (the logger first waits
# up to 30 s for the module); WATCHDOG=1 from the writer thread only while
# fdatasync of new rows keeps completing, so a recorder that hangs or stops
# writing is killed and restarted.
Type=notify
WatchdogSec=30
EnvironmentFile=-/etc/ewego/imu-usb.conf
# DEVICE is optional: with it unset the logger finds the single hub_imu by VID:PID
ExecStart=/usr/local/bin/ewego-imu-usb --out ${OUT_DIR} --name ${NAME} $DEVICE_ARG $EXTRA_ARGS
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=3
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
