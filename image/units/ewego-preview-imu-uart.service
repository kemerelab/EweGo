[Unit]
Description=EweGo UART IMU preview: live view only, nothing recorded
Documentation=file:///opt/ewego/Firmware/webtest/README.md
After=local-fs.target
# Started and stopped by the web console. Refuses to start while the
# recorder is up (ExecStartPre); the recorder unit stops this one before it
# starts, so the two never share the tty. No Conflicts=: it is symmetric and
# would let a preview stop the recorder.

[Service]
Type=simple
EnvironmentFile=-/etc/ewego/imu-uart.conf
ExecStartPre=/bin/sh -c 'case "$$(systemctl is-active ewego-imu-uart.service)" in active|activating|reloading|deactivating|refreshing) echo "ewego-imu-uart is running: no preview" >&2; exit 1;; esac'
ExecStart=/usr/local/bin/ewego-imu-uart --port ${PORT} --baud ${BAUD} --rate ${RATE} --name ${NAME} --preview --live /run/ewego --stats 5 --rt
KillSignal=SIGINT
TimeoutStopSec=10
Restart=no
RuntimeMaxSec=3600

[Install]
# none: started only by the web console, never enabled
