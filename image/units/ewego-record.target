[Unit]
Description=EweGo recorder: USB cameras, USB IMU, GPS, audio, fuel gauge
Documentation=file:///opt/ewego/image/README.md
# The default recording set. Starting the target starts every unit listed
# here; each of them is PartOf= this target, so stopping or restarting the
# target does the same to all of them. Any unit can still be run alone.
Wants=ewego-cam@camera1.service ewego-cam@camera2.service
Wants=ewego-imu-usb.service
Wants=ewego-gps.service
Wants=ewego-audio.service
Wants=ewego-fuel.service

[Install]
WantedBy=multi-user.target
